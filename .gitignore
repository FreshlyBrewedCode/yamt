# dependencies
node_modules/
.venv/
__pycache__/
*.py[oc]

# build output
dist/
build/
*.tsbuildinfo

# runtime data: never in the repo. Real data lives in ~/.yamt/ (outside the repo);
# these patterns are a second line of defence against stray local copies.
data/
.yamt/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
logs/
*.log

# test output
test-results/
playwright-report/
coverage/

# spike / scratch artefacts
results/
scratch/

# secrets and editor noise
.env
.env.*
!.env.example
*.pem
*.key
.DS_Store
.idea/
.vscode/
